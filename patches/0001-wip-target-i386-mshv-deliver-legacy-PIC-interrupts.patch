diff --git a/accel/mshv/mshv-all.c b/accel/mshv/mshv-all.c
index d7df89dbd2..46423c667e 100644
--- a/accel/mshv/mshv-all.c
+++ b/accel/mshv/mshv-all.c
@@ -710,6 +710,16 @@ static bool mshv_vcpu_thread_is_idle(CPUState *cpu)
     return false;
 }
 
+static void mshv_handle_interrupt(CPUState *cpu, int mask)
+{
+    int old_mask = qatomic_fetch_or(&cpu->interrupt_request, mask);
+
+    trace_mshv_handle_interrupt(cpu->cpu_index, mask);
+    if (!(old_mask & mask) && !qemu_cpu_is_self(cpu)) {
+        qemu_cpu_kick(cpu);
+    }
+}
+
 static void mshv_accel_ops_class_init(ObjectClass *oc, const void *data)
 {
     AccelOpsClass *ops = ACCEL_OPS_CLASS(oc);
@@ -721,7 +731,7 @@ static void mshv_accel_ops_class_init(ObjectClass *oc, const void *data)
     ops->synchronize_state = mshv_cpu_synchronize;
     ops->synchronize_pre_loadvm = mshv_cpu_synchronize_pre_loadvm;
     ops->cpus_are_resettable = mshv_cpus_are_resettable;
-    ops->handle_interrupt = generic_handle_interrupt;
+    ops->handle_interrupt = mshv_handle_interrupt;
 }
 
