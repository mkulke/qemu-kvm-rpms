# syntax=docker/dockerfile:1.3-labs
FROM quay.io/centos/centos:stream9 AS qemu-builder

RUN dnf download --source qemu-kvm && \
	rpm -ivh qemu-kvm-*.src.rpm

RUN dnf -y install 'dnf-command(config-manager)' && \
    dnf config-manager --set-enabled crb && \
    dnf -y install epel-release && \
    dnf -y update

RUN dnf builddep -y ~/rpmbuild/SPECS/qemu-kvm.spec

COPY patches/* root/rpmbuild/SOURCES/

RUN <<'EOF'
awk 'BEGIN { found=0 }
	/^Patch[0-9]+:/ { found=NR }
	{ lines[NR]=$0 }
	END {
		for (i=1; i<=NR; i++) {
		print lines[i]
		if (i==found) {
			print "# MSHV patches"
			print "Patch998: 0001-wip-target-i386-mshv-deliver-legacy-PIC-interrupts.patch"
			print "Patch999: 0002-wip-accel-mshv-override-kick-vcpu-handler.patch"
		}
	}
}' /root/rpmbuild/SPECS/qemu-kvm.spec > qemu-kvm.spec.new
EOF
RUN perl -i -pe 's/^Release: (\d+)/sprintf("Release: %d.mgns", $1+1)/e' qemu-kvm.spec.new
RUN mv qemu-kvm.spec.new /root/rpmbuild/SPECS/qemu-kvm.spec

RUN dnf install -y rpm-build
RUN rpmbuild -bb /root/rpmbuild/SPECS/qemu-kvm.spec

FROM scratch
COPY --from=qemu-builder /root/rpmbuild/RPMS/x86_64/qemu-kvm-*.rpm /
